# Copia este archivo como .env antes de iniciar el proyecto.

# Aplicación y servicios
APP_PORT=3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=contratia-postgres-change-me
POSTGRES_DB=contratia_db
REDIS_PASSWORD=contratia-redis-change-me
QDRANT_API_KEY=contratia-qdrant-change-me

# Colección de documentos usada por el sistema RAG.
QDRANT_COLLECTION=legal_chunks_es_v2_2026_06_21

# Cambia esta clave antes de desplegar. Debe tener al menos 32 caracteres.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Tokens de sesión
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Conexiones para ejecutar el backend fuera de Docker.
DATABASE_URL=postgresql://postgres:contratia-postgres-change-me@localhost:5432/contratia_db
REDIS_URL=redis://:contratia-redis-change-me@localhost:6379/0
QDRANT_URL=http://localhost:6333

# OpenAI
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Límites del chatbot
CHAT_MAX_INPUT_CHARS=4000
CHAT_MAX_HISTORY_TOKENS=6000
CHAT_MAX_CONTRACT_TOKENS=10000
CHAT_MAX_OUTPUT_TOKENS=1200
CHAT_OPENAI_TIMEOUT_SECONDS=45

# Entorno local
DEBUG=false
DEMO_USER_ENABLED=true
DEMO_USER_PASSWORD=demo

# Red y cookies
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
REFRESH_COOKIE_SECURE=true

# Integraciones (Opcionales)
GOOGLE_CLIENT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=ContratIA

# Logs
LOG_LEVEL=DEBUG
LOG_OUTPUT=console
LOG_FILE=logs/contratia.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=text
